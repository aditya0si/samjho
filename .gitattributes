# Line endings: normalise to LF in the repository.
#
# This matters more than usual here: .github/workflows/*.yml contains multi-line bash in `run:`
# blocks, and a CRLF checkout makes bash fail on `if ... then` and `name() {` constructs ("syntax
# error near unexpected token"), i.e. a Windows contributor could break CI without changing any code.
# Normalising on commit keeps the bytes CI sees identical to the bytes on disk here.
* text=auto eol=lf

# Explicit, so nobody has to reason about detection for the files that must be LF.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf

# Binary: never normalise, never diff.
*.pdf  binary
*.png  binary
*.jpg  binary
*.woff2 binary
