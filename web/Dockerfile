# samjho web — production image for the Next.js app.
#
# Build context is this directory (see infra/docker-compose.yml, service `web`).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time — Next treats them as build
# constants for server code as well as for client code — so the API URL has to be passed as a build
# arg here *and* set as a runtime env var. Changing it means rebuilding the image, not restarting it.
#
# The runtime stage uses Next's standalone output (see `output: "standalone"` in next.config.mjs):
# `.next/standalone` carries only the traced dependencies plus server.js, so the image needs neither
# node_modules nor the Next CLI. `web/public/` does not exist in this project, so it is not copied —
# add a COPY line here if that changes.
#
# Debian slim rather than alpine on purpose: the app uses Next's image optimisation, and the
# prebuilt sharp binary is glibc-linked. A musl base would need sharp rebuilt for musl.

FROM node:22-slim AS deps
WORKDIR /app
# npm ci needs the lockfile. Copying only the manifests keeps this layer cached across source edits.
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1
# A dev server and a build share `.next` and corrupt each other; inside the image there is only ever
# the build, so the override is explicitly cleared rather than inherited from the caller's shell.
ENV SAMJHO_NEXT_DIST_DIR=
RUN npm run build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
# The base image ships a non-root `node` user (uid 1000); no useradd needed.
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
# server.js is generated by the standalone build; `next start` is neither needed nor installed.
CMD ["node", "server.js"]
