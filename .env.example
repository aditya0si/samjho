# samjho — environment template. Copy to .env and fill in. Never commit .env.
#
# The app has to work with none of the optional values set: retrieval-only answers are a supported
# mode, not a broken state. Only DATABASE_URL is required.

# --- database (Postgres + pgvector) -----------------------------------------
DATABASE_URL=postgresql://samjho:samjho@localhost:5432/samjho

# --- corpus ------------------------------------------------------------------
# Where the student's own textbook PDFs live. Gitignored. Nothing here is ever served to the
# public API; see docs/adr/ADR-001-licensing-boundary.md.
CORPUS_DIR=./corpus
PDF_DIR=./corpus/pdfs

# --- embeddings / reranking (local, free, no key) ----------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- answer provider ---------------------------------------------------------
# Leave ANSWER_PROVIDER unset for retrieval-only answers (no external calls at all).
# "openai-compatible" works with any OpenAI-shaped endpoint, including free tiers.
ANSWER_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- retrieval tuning --------------------------------------------------------
# Reciprocal-rank fusion weight for the full-text arm (the vector arm gets 1 - this).
FTS_WEIGHT=0.4
# Measured: Hit@4 does not move above 24 (0.900 at 24, 40 and 60 candidates); the remaining misses
# are ranking failures, not recall. Raising this costs ~1.7x rerank time for no measured gain.
RETRIEVAL_CANDIDATES=24
RETRIEVAL_TOP_K=6
RRF_K=60
# Refusals are decided in two bands, because the answerable and unanswerable score distributions
# overlap: a single threshold either over-refuses real questions or answers unrelated ones.
#   answer iff  top >= REFUSAL_CONFIDENT_SCORE
#           or (top >= REFUSAL_MIN_SCORE and overlap >= REFUSAL_MIN_OVERLAP)
# Calibrated on a 937-chunk Science corpus over 20 golden + 15 refusal questions; measured margins:
#   0.0259 < 0.05 < 0.0970   and   0.30 < 0.40 < 0.50   and   0.4359 < 0.95 < 0.9688
# The confident line is 0.95 rather than 0.90 because the maths refusal set caught the reranker
# being confidently wrong: an off-syllabus Class 12 question scored 0.9073 with 0.20 lexical
# support and was answered. Above the line a high score answers on its own; below it, the passage
# must also share the question's words.
REFUSAL_MIN_SCORE=0.05
REFUSAL_CONFIDENT_SCORE=0.95
REFUSAL_MIN_OVERLAP=0.40
# Caps how many fused candidates the cross-encoder sees; 0 ranks all of them.
RERANK_CANDIDATES=0
# A passage is quoted in a retrieval-only answer only if it scores at least this fraction of the
# best one, so a weak tail cannot ride along with a strong hit.
QUOTE_MIN_RATIO=0.5

# --- local inference ---------------------------------------------------------
# Torch's default thread count oversubscribes a busy machine. Measured here on real ~800-char
# chunks: a single query encode is 64-130 ms at 1-4 threads but ~1700 ms at the default 10, and
# reranking 24 pairs is 10.1 s at 1 thread vs 5.1 s at 4. Raise it for bulk ingest on an idle host.
TORCH_THREADS=4

# --- web ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
